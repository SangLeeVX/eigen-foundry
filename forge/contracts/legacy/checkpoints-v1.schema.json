{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.eigenbio.ai/schemas/forge-checkpoints-v1.json",
  "title": "Forge phase checkpoints",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "canonical_repository",
    "classification",
    "updated_at",
    "phases",
    "blockers"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project": {"type": "string", "minLength": 1},
    "canonical_repository": {"type": "string", "minLength": 1},
    "classification": {"const": "NONCANONICAL_ENGINEERING_STATE"},
    "updated_at": {"type": "string", "format": "date-time"},
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase_id", "checkpoint_id", "name", "status", "exit_criteria"],
        "properties": {
          "phase_id": {"type": "string", "pattern": "^P[0-9]+$"},
          "checkpoint_id": {"type": "string", "pattern": "^CP-P[0-9]+$"},
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["PENDING", "IN_PROGRESS", "BLOCKED", "COMPLETED"]},
          "exit_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["criterion_id", "description", "status", "evidence"],
              "properties": {
                "criterion_id": {"type": "string", "minLength": 1},
                "description": {"type": "string", "minLength": 1},
                "status": {"enum": ["PENDING", "BLOCKED", "VERIFIED"]},
                "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
              }
            }
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["blocker_id", "phase_id", "type", "description", "owner", "status"],
        "properties": {
          "blocker_id": {"type": "string", "minLength": 1},
          "phase_id": {"type": "string", "pattern": "^P[0-9]+$"},
          "type": {"enum": ["AUTHORITY", "SECURITY", "DEPENDENCY", "TECHNICAL"]},
          "description": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "status": {"enum": ["OPEN", "RESOLVED"]}
        }
      }
    }
  }
}
