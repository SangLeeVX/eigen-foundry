{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.eigenbio.ai/schemas/forge-checkpoints-v2.json",
  "title": "Forge product milestone checkpoints",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "canonical_repository",
    "classification",
    "updated_at",
    "active_build_mandate",
    "migration",
    "milestones",
    "blockers"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "project": {"type": "string", "minLength": 1},
    "canonical_repository": {"type": "string", "minLength": 1},
    "classification": {"const": "NONCANONICAL_ENGINEERING_STATE"},
    "updated_at": {"type": "string", "format": "date-time"},
    "active_build_mandate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mandate_id",
        "version",
        "document_path",
        "plan_sha256",
        "approved_repository_head",
        "authoring_run_id",
        "status",
        "approved_at",
        "approvals",
        "independent_review"
      ],
      "properties": {
        "mandate_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "document_path": {"type": "string", "minLength": 1},
        "plan_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "approved_repository_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "authoring_run_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["APPROVED_PENDING_ACTIVATION", "ACTIVE", "SUPERSEDED"]},
        "approved_at": {"type": "string", "format": "date-time"},
        "approvals": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "approval_id",
              "approver",
              "actor_ref",
              "actor_kind",
              "role",
              "decision",
              "approved_at",
              "expires_at",
              "conditions",
              "bound_plan_sha256",
              "bound_repository_head",
              "evidence"
            ],
            "properties": {
              "approval_id": {"type": "string", "minLength": 1},
              "approver": {"type": "string", "minLength": 1},
              "actor_ref": {"type": "string", "minLength": 1},
              "actor_kind": {"const": "HUMAN"},
              "role": {"enum": ["BUILD_MANDATE_OWNER", "ENGINEERING_AUTHORITY", "FOUNDRY_GOVERNANCE_SAFETY_AUTHORITY"]},
              "decision": {"const": "APPROVED"},
              "approved_at": {"type": "string", "format": "date-time"},
              "expires_at": {"type": ["string", "null"], "format": "date-time"},
              "conditions": {"type": "string", "minLength": 1},
              "bound_plan_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "bound_repository_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "evidence": {"type": "string", "minLength": 1}
            }
          }
        },
        "independent_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "review_id",
            "reviewer_run_id",
            "authoring_run_id",
            "verdict",
            "reviewed_repository_head",
            "evidence"
          ],
          "properties": {
            "review_id": {"type": "string", "minLength": 1},
            "reviewer_run_id": {"type": "string", "minLength": 1},
            "authoring_run_id": {"type": "string", "minLength": 1},
            "verdict": {"const": "PASS"},
            "reviewed_repository_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "evidence": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migration_id",
        "created_at",
        "actor_run_id",
        "status",
        "status_inheritance",
        "therapeutic_program_state_changes",
        "source",
        "blueprint",
        "crosswalk",
        "program_gate_coverage"
      ],
      "properties": {
        "migration_id": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "actor_run_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["PENDING_PROTECTED_MERGE", "ACTIVE", "SUPERSEDED"]},
        "status_inheritance": {"const": false},
        "therapeutic_program_state_changes": {"const": false},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "schema_sha256",
            "state_sha256",
            "archived_schema_path",
            "archived_state_path"
          ],
          "properties": {
            "schema_version": {"const": "1.0.0"},
            "schema_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "state_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "archived_schema_path": {"type": "string", "minLength": 1},
            "archived_state_path": {"type": "string", "minLength": 1}
          }
        },
        "blueprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["document_id", "version", "library_path", "sha256"],
          "properties": {
            "document_id": {"const": "BUILD-EIGEN-FOUNDRY-002"},
            "version": {"const": "0.2"},
            "library_path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        },
        "crosswalk": {
          "type": "array",
          "minItems": 22,
          "maxItems": 22,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "namespace",
              "target_milestones",
              "treatment",
              "status_inherited",
              "criterion_routes"
            ],
            "properties": {
              "source_id": {"type": "string", "minLength": 1},
              "namespace": {"enum": ["LEGACY_ENGINEERING_PHASE", "LEGACY_BUILD_FOUNDATION", "LEGACY_BUILD_INCREMENT"]},
              "target_milestones": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "pattern": "^M[0-9]$"}
              },
              "treatment": {"enum": ["CARRIED", "SPLIT", "SUPERSEDED"]},
              "status_inherited": {"const": false},
              "criterion_routes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["source_criterion_id", "target_milestones"],
                  "properties": {
                    "source_criterion_id": {"type": "string", "minLength": 1},
                    "target_milestones": {
                      "type": "array",
                      "minItems": 1,
                      "items": {"type": "string", "pattern": "^M[0-9]$"}
                    }
                  }
                }
              }
            }
          }
        },
        "program_gate_coverage": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "target_milestone", "changes_program_state"],
            "properties": {
              "source_id": {"enum": ["PROGRAM_GATE_F0_F2", "PROGRAM_GATE_F3_F8", "PROGRAM_GATE_F9_F12"]},
              "target_milestone": {"type": "string", "pattern": "^M[0-9]$"},
              "changes_program_state": {"const": false}
            }
          }
        }
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "milestone_id",
          "checkpoint_id",
          "name",
          "status",
          "dependencies",
          "maximum_claim_on_completion",
          "exit_criteria"
        ],
        "properties": {
          "milestone_id": {"type": "string", "pattern": "^M[0-9]$"},
          "checkpoint_id": {"type": "string", "pattern": "^CP-M[0-9]$"},
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["NOT_STARTED", "PARTIAL", "IN_PROGRESS", "BLOCKED", "COMPLETED"]},
          "dependencies": {
            "type": "array",
            "items": {"type": "string", "pattern": "^M[0-9]$"}
          },
          "maximum_claim_on_completion": {
            "enum": [
              "NO_PRODUCT_CLAIM",
              "TECHNICAL_FOUNDATION",
              "SYNTHETIC_CONCLAVE_HARNESS",
              "WORKING_CONCLAVE",
              "WORKING_FOUNDRY_MVP",
              "PRODUCTION_QUALIFIED_FOUNDRY"
            ]
          },
          "exit_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["criterion_id", "description", "status", "evidence"],
              "properties": {
                "criterion_id": {"type": "string", "pattern": "^M[0-9]-C[0-9]+$"},
                "description": {"type": "string", "minLength": 1},
                "status": {"enum": ["PENDING", "BLOCKED", "VERIFIED"]},
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "evidence_id",
                      "type",
                      "locator",
                      "immutable_revision",
                      "bound_criterion_id",
                      "result"
                    ],
                    "properties": {
                      "evidence_id": {"type": "string", "minLength": 1},
                      "type": {
                        "enum": [
                          "GITHUB_ISSUE_COMMENT",
                          "GITHUB_PR_REVIEW",
                          "GITHUB_MERGE_COMMIT",
                          "GITHUB_ACTION_RUN",
                          "SECURITY_REPORT",
                          "SIGNED_APPROVAL",
                          "RELEASE_EVIDENCE"
                        ]
                      },
                      "locator": {"type": "string", "minLength": 1},
                      "immutable_revision": {"type": "string", "minLength": 1},
                      "bound_criterion_id": {"type": "string", "pattern": "^M[0-9]-C[0-9]+$"},
                      "result": {"enum": ["PASS", "APPROVED", "VERIFIED"]}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "blocker_id",
          "milestone_id",
          "criterion_ids",
          "type",
          "description",
          "owner",
          "status",
          "evidence"
        ],
        "properties": {
          "blocker_id": {"type": "string", "minLength": 1},
          "milestone_id": {"type": "string", "pattern": "^M[0-9]$"},
          "criterion_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^M[0-9]-C[0-9]+$"}
          },
          "type": {"enum": ["AUTHORITY", "SECURITY", "DEPENDENCY", "TECHNICAL"]},
          "description": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "status": {"enum": ["OPEN", "RESOLVED"]},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_id",
                "type",
                "locator",
                "immutable_revision",
                "bound_criterion_id",
                "result"
              ],
              "properties": {
                "evidence_id": {"type": "string", "minLength": 1},
                "type": {
                  "enum": [
                    "GITHUB_ISSUE_COMMENT",
                    "GITHUB_PR_REVIEW",
                    "GITHUB_MERGE_COMMIT",
                    "GITHUB_ACTION_RUN",
                    "SECURITY_REPORT",
                    "SIGNED_APPROVAL",
                    "RELEASE_EVIDENCE"
                  ]
                },
                "locator": {"type": "string", "minLength": 1},
                "immutable_revision": {"type": "string", "minLength": 1},
                "bound_criterion_id": {"type": "string", "pattern": "^M[0-9]-C[0-9]+$"},
                "result": {"enum": ["PASS", "APPROVED", "VERIFIED"]}
              }
            }
          }
        }
      }
    }
  }
}
